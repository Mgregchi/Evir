# Hosting: set these same two addresses on BOTH the public site and Studio.
# Include any subdirectory in the URL; there is no separate base-path setting.
# SITE_URL preserves the public address already configured for this project.
SITE_URL=https://evir.idey.click
# Fill with the actual Studio URL before publishing. Empty uses local port 8788.
STUDIO_URL=

# Optional links: public site ONLY. Leave unused values empty.
# Defaults: repository below; docs and feedback use its research guide/issues.
REPOSITORY_URL=https://github.com/Mgregchi/Evir
DOCS_URL=
COMMUNITY_URL=
FEEDBACK_URL=
NEWSLETTER_URL=
SOCIAL_X_URL=
SOCIAL_LINKEDIN_URL=
SOCIAL_MASTODON_URL=
CONTACT_URL=

# These are public build-time values. Rebuild after editing. Never add secrets.
