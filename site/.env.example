# All PUBLIC_* values are embedded in the frontend. Never put secrets here.
# Copy to site/.env for local builds; set repository Actions variables for Pages.
# Leave optional URLs empty to hide their links. No fictitious channels are shown.
PUBLIC_SITE_URL=
PUBLIC_BASE_PATH=
PUBLIC_REPOSITORY_URL=https://github.com/Mgregchi/Evir
PUBLIC_DOCS_URL=
PUBLIC_COMMUNITY_URL=
PUBLIC_FEEDBACK_URL=
PUBLIC_NEWSLETTER_URL=
PUBLIC_SOCIAL_X_URL=
PUBLIC_SOCIAL_LINKEDIN_URL=
PUBLIC_SOCIAL_MASTODON_URL=
PUBLIC_CONTACT_URL=
